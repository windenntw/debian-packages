#!/bin/sh
set -e

case "$1" in
    configure)
        TMPDIR=$(mktemp -d)
        trap 'rm -rf "$TMPDIR"' EXIT

        echo "Downloading Ollama @VERSION@..."
        PAYLOAD="${TMPDIR}/ollama-linux-amd64.tar.zst"
        curl -fSL "@UPSTREAM_URL@" -o "${PAYLOAD}"

        ACTUAL_HASH=$(sha256sum "${PAYLOAD}" | cut -d' ' -f1)
        if [ "${ACTUAL_HASH}" != "@SHA256@" ]; then
            echo "Checksum verification failed for Ollama @VERSION@" >&2
            exit 1
        fi

        rm -rf /usr/lib/ollama
        install -o 0 -g 0 -m 0755 -d /usr/bin /usr/lib/ollama
        zstd -dc "${PAYLOAD}" | tar --no-same-owner -xf - -C /usr

        # Install AMD ROCm libraries if an AMD GPU is detected.
        if [ -n "@ROCM_URL@" ] && command -v lspci >/dev/null 2>&1 && lspci -d '1002:' | grep -q 'AMD'; then
            echo "AMD GPU detected, downloading Ollama ROCm libraries @VERSION@..."
            ROCM_PAYLOAD="${TMPDIR}/ollama-linux-amd64-rocm.tar.zst"
            curl -fSL "@ROCM_URL@" -o "${ROCM_PAYLOAD}"

            ACTUAL_ROCM_HASH=$(sha256sum "${ROCM_PAYLOAD}" | cut -d' ' -f1)
            if [ "${ACTUAL_ROCM_HASH}" != "@ROCM_SHA256@" ]; then
                echo "Checksum verification failed for Ollama ROCm @VERSION@" >&2
                exit 1
            fi

            zstd -dc "${ROCM_PAYLOAD}" | tar --no-same-owner -xf - -C /usr
        fi

        # Configure ollama system user, groups, and systemd service.
        if ! id ollama >/dev/null 2>&1; then
            useradd -r -s /bin/false -U -m -d /usr/share/ollama ollama
        fi
        if getent group render >/dev/null 2>&1; then
            usermod -a -G render ollama
        fi
        if getent group video >/dev/null 2>&1; then
            usermod -a -G video ollama
        fi

        cat <<'EOF' > /etc/systemd/system/ollama.service
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=@BINARY_PATH@ serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=default.target
EOF
        chmod 0644 /etc/systemd/system/ollama.service

        if command -v systemctl >/dev/null 2>&1; then
            case "$(systemctl is-system-running 2>/dev/null || true)" in
                running|degraded)
                    systemctl daemon-reload
                    systemctl enable ollama
                    systemctl restart ollama
                    ;;
            esac
        fi
        ;;
esac
